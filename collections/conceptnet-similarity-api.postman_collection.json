        {
          "id": "16458ca1-2a3e-4c86-831b-e8d8426a4eeb",
          "name": "Compute pairwise relatedness score",
          "request": {
            "name": "Compute pairwise relatedness score",
            "description": {
              "content": "Returns a single floating-point relatedness score between 0 and 1 for any two ConceptNet concept URIs, computed from Numberbatch word vector cosine similarity. A score of 1.0 indicates maximum similarity and 0.0 indicates no detectable relationship. This endpoint and /related each count as 2 requests against the rate limit quota.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "relatedness"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "node1",
                  "value": "<string>",
                  "description": "(Required) First ConceptNet concept URI"
                },
                {
                  "disabled": false,
                  "key": "node2",
                  "value": "<string>",
                  "description": "(Required) Second ConceptNet concept URI"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
