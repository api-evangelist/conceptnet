    {
      "id": "dfaeb721-6750-429e-9b3a-2b911d03ea21",
      "name": "Similarity",
      "description": {
        "content": "Semantic similarity and relatedness using Numberbatch embeddings",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "aeec682e-105d-4750-8d0e-aea0012b9522",
          "name": "Find semantically related concepts",
          "request": {
            "name": "Find semantically related concepts",
            "description": {
              "content": "Returns a ranked list of concepts most semantically related to the given URI, using ConceptNet Numberbatch word vector similarity. Results are sorted by descending relatedness weight. This endpoint and /relatedness each count as 2 requests against the rate limit quota (3,600 req/hour, 120 req/min). The optional filter parameter restricts results to a particular language subtree.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "related",
                ":uri"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of related concepts to return (0-100)"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Restrict results to URIs under this prefix (e.g. /c/en to limit to English concepts)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "uri",
                  "description": "(Required) ConceptNet URI path (e.g. c/en/dog — the leading slash is part of the base path, so omit it here)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "9fffe1c0-b068-417d-86d1-72f8a1807cb7",
