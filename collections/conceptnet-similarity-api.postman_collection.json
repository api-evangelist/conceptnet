  "info": {
    "_postman_id": "13ea8c47-ec87-49c0-90ea-e8cad6a32231",
    "name": "ConceptNet REST Concepts Similarity API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "ConceptNet is a freely available multilingual knowledge graph providing computers access to common-sense knowledge. The REST API exposes the full ConceptNet 5 knowledge graph via JSON-LD endpoints. Consumers can look up concept nodes by language and term, query edges by relation type, retrieve semantically related terms ranked by Numberbatch embedding similarity, compute pairwise relatedness scores between concepts, and normalize natural-language text into canonical ConceptNet URIs. No authentication or API key is required.\n\nContact Support:\n Name: ConceptNet Users Group",
      "type": "text/plain"
    }
  }
