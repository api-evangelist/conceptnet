          "name": "Look up a sense-disambiguated concept node",
          "request": {
            "name": "Look up a sense-disambiguated concept node",
            "description": {
              "content": "Returns a JSON-LD node object for a specific word sense of the concept. The sense component is a part-of-speech tag (n, v, a, r) or a more specific sense identifier. For example, /c/en/lead/n returns the noun sense of \"lead\" while /c/en/lead/v returns the verb sense.",
              "type": "text/plain"
            },
            "url": {
              "path": [
