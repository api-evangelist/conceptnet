  "item": [
    {
      "id": "593c82a3-30e6-4775-8941-0196464fa542",
      "name": "Concepts",
      "description": {
        "content": "Look up concept nodes in the knowledge graph",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d35c51bb-d199-4f59-9c88-7504a9e152d6",
          "name": "Look up a concept node",
          "request": {
            "name": "Look up a concept node",
            "description": {
              "content": "Returns a JSON-LD node object for the concept identified by language and term. The response includes all edges (assertions) connecting the concept to other concepts, paginated via offset and limit. The term may include underscores in place of spaces and an optional sense disambiguation suffix (e.g. /c/en/lead/n for the noun sense of \"lead\").",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "c",
                ":language",
                ":term"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination (0-100000)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of results to return (0-1000)"
                },
                {
                  "disabled": false,
                  "key": "grouped",
                  "value": "false",
                  "description": "When true, groups edges by relation type rather than returning a flat list."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "language",
                  "description": "(Required) BCP-47 language code (e.g. en, fr, de, zh, ja, es)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "term",
                  "description": "(Required) Concept term in the given language, with spaces replaced by underscores (e.g. french_toast, dog, run_away)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
